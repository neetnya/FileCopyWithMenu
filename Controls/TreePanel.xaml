<UserControl x:Class="FileCopyWithMenu.Controls.TreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FileCopyWithMenu.Core"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             FontSize="12.5"
             Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>

        <!-- 展开箭头 -->
        <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M 3,5 L 9,10 L 3,15 Z"
                                  Fill="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 节点行：选中/焦点高亮 -->
        <Style x:Key="NodeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" CornerRadius="3" BorderThickness="1" Margin="0,0,2,1" Padding="1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SelBgBrush}" />
                                                <Setter Property="BorderBrush" Value="#8FB4E8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SelBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press"
                                                  Style="{StaticResource ExpanderToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <!-- 没有子项（文件、空文件夹）：不显示展开箭头 -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 节点内容 -->
        <HierarchicalDataTemplate DataType="{x:Type core:FileNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1,6,1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" Margin="0,0,5,0" FontSize="13"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource FileIconBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DirIconBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource LinkIconBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                <TextBlock Grid.Column="2" Text="{Binding MetaText}" Margin="12,0,0,0" FontSize="11"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="10,8,10,2">
                <TextBlock x:Name="HeaderText" Text="目录" Style="{StaticResource PanelTitle}" />
                <TextBlock x:Name="InfoText" Text="未选择" Style="{StaticResource HintText}"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </Grid>

            <!-- 路径 -->
            <Grid Grid.Row="1" Margin="10,4,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="目录" Style="{StaticResource HintText}" Margin="0,0,6,0" />
                <TextBox x:Name="PathBox" Grid.Column="1" VerticalContentAlignment="Center"
                         KeyDown="PathBox_KeyDown" />
                <Button Grid.Column="2" Content="浏览…" Margin="6,0,0,0" Padding="10,3" Click="Browse_Click" />
                <Button Grid.Column="3" Content="刷新" Margin="4,0,0,0" Padding="10,3" Click="Refresh_Click" />
                <Button Grid.Column="4" Content="上级" Margin="4,0,0,0" Padding="10,3" Click="Up_Click" />
            </Grid>

            <!-- 工具条 -->
            <Grid Grid.Row="2" Margin="10,8,10,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="全展开" Padding="10,3" Click="ExpandAll_Click" />
                    <Button Content="全折叠" Padding="10,3" Margin="4,0,0,0" Click="CollapseAll_Click" />
                    <Rectangle Width="1" Fill="{StaticResource CardBorderBrush}" Margin="8,2,8,2" />
                    <Button Content="全选" Padding="10,3" Click="SelectAll_Click" />
                    <Button Content="清空选择" Padding="10,3" Margin="4,0,0,0" Click="ClearSelection_Click" />
                </StackPanel>
            </Grid>

            <!-- 树 -->
            <Grid Grid.Row="3">
                <TreeView x:Name="Tree" Margin="6,0,4,8" Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource NodeItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          PreviewKeyDown="Tree_PreviewKeyDown"
                          ContextMenuOpening="Tree_ContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <!-- 索引 0 固定为“复制到右侧”，代码里按索引控制显隐 -->
                            <MenuItem Header="复制到右侧    Ctrl+→" Click="MiCopy_Click" />
                            <Separator />
                            <MenuItem Header="展开 / 折叠" Click="MiToggle_Click" />
                            <MenuItem Header="展开整个子树" Click="MiExpandSubtree_Click" />
                            <Separator />
                            <MenuItem Header="用资源管理器打开" Click="MiOpen_Click" />
                            <MenuItem Header="复制完整路径" Click="MiCopyPath_Click" />
                            <Separator />
                            <MenuItem Header="全展开" Click="ExpandAll_Click" />
                            <MenuItem Header="全折叠" Click="CollapseAll_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
                <!-- 空状态提示：没有打开任何目录时显示 -->
                <TextBlock x:Name="EmptyHint" Text="点【浏览…】选择目录"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource HintText}" IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
