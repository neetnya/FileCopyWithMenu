<Application x:Class="FileCopyWithMenu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ 配色 ============ -->
            <SolidColorBrush x:Key="AppBgBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D8DBE0" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#24292F" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="AccentBrush" Color="#1A5FB4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B6EC2" />
            <SolidColorBrush x:Key="SelBgBrush" Color="#D6E4FB" />
            <SolidColorBrush x:Key="SelBorderBrush" Color="#1A5FB4" />
            <SolidColorBrush x:Key="HoverBgBrush" Color="#EDF1F6" />
            <SolidColorBrush x:Key="SoftBgBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
            <SolidColorBrush x:Key="OkBrush" Color="#0F7B2F" />
            <SolidColorBrush x:Key="DirIconBrush" Color="#D9A02B" />
            <SolidColorBrush x:Key="FileIconBrush" Color="#5B7C9E" />
            <SolidColorBrush x:Key="LinkIconBrush" Color="#8A5A00" />

            <!-- ============ 基础按钮 ============ -->
            <Style x:Key="AppButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B9C6D6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2EAF5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource AppButton}" />

            <!-- ============ 主按钮（复制） ============ -->
            <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="Width" Value="62" />
                <Setter Property="Height" Value="62" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Fill" Value="#134C92" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Fill" Value="#B9C0CC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 输入框 ============ -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- ============ 复选框 / 下拉框 ============ -->
            <Style TargetType="CheckBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- ============ 卡片标题 ============ -->
            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ============ 右键菜单 ============ -->
            <Style TargetType="MenuItem">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
